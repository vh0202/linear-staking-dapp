# Only needed for the Sepolia steps in docs/deployment.md, which were NOT EXECUTED in this
# repository. Nothing here is needed for compiling, testing or the local demo.
#
# Either copy this file to .env (git-ignored) and fill it in, or keep the values out of
# files altogether with the encrypted Hardhat keystore:
#   npx hardhat keystore set SEPOLIA_RPC_URL
#   npx hardhat keystore set SEPOLIA_PRIVATE_KEY
#   npx hardhat keystore set ETHERSCAN_API_KEY
#
# Use a throw-away testnet account. Never commit real values.
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
ETHERSCAN_API_KEY=
