# Front-end configuration. Copy to .env.local and adjust.
#
# For the local demo you do not need to: `npm run deploy:local` in the repository root
# writes .env.local for you.
#
# Every value is public: NEXT_PUBLIC_* variables are inlined into the browser bundle.
# Do not put secrets in this file or in .env.local.

# Chain the app talks to: 31337 = local Hardhat node, 11155111 = Sepolia.
NEXT_PUBLIC_CHAIN_ID=31337

# JSON-RPC endpoint. Optional on Sepolia (the chain's public endpoint is used when empty).
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Address of the LinearStaking contract. The value below is where `npm run deploy:local`
# deploys it on a freshly started local node.
NEXT_PUBLIC_STAKING_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

# LOCAL DEMO ONLY. Adds a "Local Demo Wallet" to the connect dialog that acts as one of the
# local Hardhat node's built-in test accounts, without a browser extension. It only works
# because that node signs for its own test accounts, and it is ignored on any other chain.
NEXT_PUBLIC_ENABLE_DEMO_WALLET=false
NEXT_PUBLIC_DEMO_WALLET_ADDRESS=

# Optional. A WalletConnect Cloud project id enables the WalletConnect-based wallets in
# the connect dialog. Without it only browser-extension wallets are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
