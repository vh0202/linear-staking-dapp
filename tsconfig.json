{
  "compilerOptions": {
    "lib": ["es2023"],
    "module": "node20",
    "target": "es2023",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": ["hardhat.config.ts", "artifacts/**/*.d.ts", "test/**/*.ts", "test-helpers/**/*.ts", "scripts/**/*.ts", "ignition/**/*.ts"],
  "exclude": ["frontend", "node_modules"]
}
